{
  "name": "crm-sales-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for a CRM Sales Management System",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:rbac": "node --test tests/rbac.test.js",
    "test:leads": "node --test tests/lead-conversion.test.js",
    "test:deals": "node --test tests/deal-rules.test.js",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
